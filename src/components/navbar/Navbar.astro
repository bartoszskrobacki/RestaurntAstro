---
import { Image } from 'astro:assets'
import logo from '@media/images/logo_u_piotra.png'
import { Menu } from '@components/navbar/Menu.tsx'
import Contact from './Contact.astro'
import { BUSINESS } from '@config/business'

const pathName = Astro.url.pathname
---

<div class="fixed top-0 z-10 w-full bg-primary bg-opacity-95 px-9 text-primary-800 shadow-md">
	<div class="mx-auto flex max-w-7xl items-center justify-between">
		<Image src={logo} alt="logo" height={64} loading={'eager'} />
		<Menu pathName={pathName} client:idle />
		<Contact phoneNumber={BUSINESS.phones[0]} />
	</div>
</div>
