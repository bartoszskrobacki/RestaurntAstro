---
import Layout from '@layouts/Layout.astro'

import { Contact } from '@components/contact/Contact.tsx'

export interface FoodMenuItem {
	name: string
	price: string
	description?: string
}

export interface FoodCategory {
	contentTypeId: string
	name: string
	fields: FoodMenuItem[]
}
---

<Layout
	title="Kontakt i godziny otwarcia – Bar u Piotra Gliwice"
	description="Bar u Piotra w Gliwicach – telefon 32 232 24 02, adres, godziny otwarcia i zamówienia na dowóz. Czynne pon.–pt. 10:00–18:00, sob. 10:00–16:00, niedz. 11:00–16:00."
>
	<main>
		<Contact client:visible />
	</main>
</Layout>
