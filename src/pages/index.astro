---
import Layout from '@layouts/Layout.astro'
import FoodMenu from '@components/foodMenu/FoodMenu.astro'
import MainBanner from '@components/banners/MainBanner.astro'
import DiscountBanner from '@components/banners/DiscountBanner.tsx'
import Image from 'node_modules/astro/components/Image.astro'
import kpr_banner from '@media/images/kpr_banner.webp'

export interface FoodMenuItem {
	name: string
	price: string
	description?: string
}

export interface FoodCategory {
	contentTypeId: string
	name: string
	fields: FoodMenuItem[]
}
---

<Layout
	title="Bar u Piotra Gliwice – domowe obiady, bar mleczny, dania dnia"
	description="Bar u Piotra w Gliwicach – tanie domowe obiady jak w barze mlecznym. Codziennie świeże dania dnia, zupy i obiady z dowozem na terenie Gliwic. Otwarte od 10:00."
>
	<main>
		<MainBanner />

		<section class="mx-auto max-w-4xl px-7 py-12 text-center">
			<h1>Bar u Piotra Gliwice</h1>
			<p class="text-primary-200">
				Domowe obiady w cenach baru mlecznego, w samym centrum Gliwic przy ul. Zwycięstwa 17.
				Codziennie od poniedziałku do piątku przygotowujemy świeże dania dnia: zupy, kotlety,
				pierogi i dania jednogarnkowe. Zamówienia przyjmujemy telefonicznie, dowozimy na terenie
				Gliwic – zobacz <a href="/menu/">pełne menu i ceny</a> albo zamów
				<a href="/dlafirm/">catering dla firm</a>.
			</p>
		</section>

		<DiscountBanner client:load />

		<a href="/cele" class="after:content-none"
			><Image
				src={kpr_banner}
				alt="Bar u Piotra – projekt dofinansowany ze środków UE"
				class="mx-auto"
			/></a
		>

		<FoodMenu heading="Nasze menu" />
	</main>
</Layout>
